# ---- Generated databases & blobs ----
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/store/
data/cache/
data/blobs/

# Generated demonstration payloads. The assembly is built from source by
# interlock/synthetic/ and rebuilt by `python -m interlock.cli demo`, which is
# what docs/LICENCES.md says happens -- so the STEP files and the render are
# build output, not sources, and do not belong in the history.
data/demo/*
!data/demo/.gitkeep

# ---- Generated / downloaded CAD payloads ----
# Third-party CAD is redistributed under its own licence; see docs/LICENCES.md.
data/external/
*.stp.large
*.FCStd1

